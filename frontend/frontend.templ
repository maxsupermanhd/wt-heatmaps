package frontend

import "fmt"
import "math"

templ Page(content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, height=device-height, initial-scale=1.0"/>
			<title>WT-Heatmaps</title>
			<link href={ StaticAssets.URL("style.css") } rel="stylesheet"/>
			<link href="/static/nanachi-favicon.png" rel="icon"/>
			<script src={ StaticAssets.URL("htmx.min.js") }></script>
			// <script src={ StaticAssets.URL("htmx-ext-ws.min.js") }></script>
		</head>
		<body class="mainstyle">
			<style>
				.title{font-weight: bold;font-size: larger;margin-right: 1em;}
				.header > span > a {margin-right: 1em;}
			</style>
			<nav class="header">
				<span class="title">War Thunder Heatmaps</span>
				<span><a href="/">View</a></span>
				<span><a href="/stats">Stats</a></span>
				<span><a href="/about">About</a></span>
				<span><a href="/about/api">API</a></span>
				<span><a href="/about/changelog">Changelog</a></span>
				@templ.Raw(currentNotification)
				<span style="float: right;"><small>by flexcoral</small></span>
			</nav>
			@content
		</body>
	</html>
}

templ WaitroomPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, height=device-height, initial-scale=1.0"/>
			<title>WT-Heatmaps</title>
			<link href={ StaticAssets.URL("style.css") } rel="stylesheet"/>
			<link href="/static/nanachi-favicon.png" rel="icon"/>
		</head>
		<body class="mainstyle">
			<style>
				.title{font-weight: bold;font-size: larger;margin-right: 1em;}
				.header > span > a {margin-right: 1em;}
			</style>
			<nav class="header">
				<span class="title">War Thunder Heatmaps</span>
				<span><a href="/">View</a></span>
				<span><a href="/stats">Stats</a></span>
				<span><a href="/about">About</a></span>
				<span><a href="/about/api">API</a></span>
				<span><a href="/about/changelog">Changelog</a></span>
				<span style="float: right;"><small>by flexcoral</small></span>
			</nav>
			<div style="text-align: center;">
				<h2>Please wait</h2>
				<p>Getting data ready for you...</p>
				<p><small><i>This page will refresh periodically</i></small></p>
			</div>
		</body>
	</html>
}

type LevelStat struct {
	Level        string
	LevelDisplay string
	Samples      int
}

templ Index(levels []LevelStat, battleRatingMax int) {
	<div class="content">
		<div class="map">
			<div id="loadingIndicators" class="loadingIndicators"></div>
			<svg id="mapview" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" style="user-select: none;">
				<style>
					#tankmap {
						filter: brightness(35%)
					}
					.mapview-text-heading {
						user-select: none;
						font: bold 80px sans-serif;
						fill: #ddd;
					}
					.mapview-text-normal {
						user-select: none;
						font: normal 40px sans-serif;
						fill: #aaa;
					}
				</style>
				<text x="200" y="280" class="mapview-text-heading">
					Type a map name in the map box
				</text>
				<text x="200" y="380" class="mapview-text-normal">
					Data is being rendered in real time with a LOT of data points on very low power hardware,
				</text>
				<text x="200" y="420" class="mapview-text-normal">
					please be patient, it can take few seconds for it to load.
				</text>
				<image style="image-rendering: pixelated;" id="tankmap"></image>
				<image style="image-rendering: pixelated; width:2048px; height:2048px" id="heat"></image>
				<rect id="areaSelect" style="display: none; fill: #ffffff20; stroke: #fff; stroke-width: 2; vector-effect: non-scaling-stroke;"></rect>
				<g id="mapviewLines"></g>
			</svg>
		</div>
		<div class="panelToggles">
			<button type="button" popovertarget="settingsDiv">Settings</button>
			<button type="button" popovertarget="areaPanel" id="areaToggle">Area</button>
		</div>
		<div id="settingsDiv" class="settings" popover>
			<form id="settingsForm" class="controls">
				<section class="ctlGroup">
					<h3>Map</h3>
					<input id="mapSearch" type="search" placeholder="Type a map name..." autocomplete="off" role="combobox" aria-controls="levelSelector" aria-expanded="false"/>
					<input id="settingsFormLevelInput" name="level" type="hidden"/>
					<div popover="manual" id="levelSelector" class="mapList" role="listbox">
						for _, v := range levels {
							<button type="button" role="option" tabindex="-1" data-level={ v.Level } data-name={ v.LevelDisplay }>
								<img src={ "/minimap/128/" + v.Level + ".png" } width="40" height="40" alt="" loading="lazy"/>
								<span>{ v.LevelDisplay }</span>
								<small>{ v.Samples }</small>
							</button>
						}
					</div>
				</section>
				<section class="ctlGroup">
					<h3>Display</h3>
					<div class="ctlRow">
						<label for="scoreIntensity">Exposure</label>
						<input id="scoreIntensity" name="scoreIntensity" type="number" value="32" min="1" max="255"/>
						<label for="countIntensity">Brightness</label>
						<input id="countIntensity" name="countIntensity" type="number" value="32" min="1" max="255"/>
						<button type="button" class="iconBtn" popovertarget="helpExposureBrightness" title="What do these do?">ⓘ</button>
					</div>
					<div popover id="helpExposureBrightness" class="infoBox">
						<div class="infoHead">
							<h3>Exposure and brightness</h3>
							<button type="button" class="iconBtn" popovertarget="helpExposureBrightness" popovertargetaction="hide" aria-label="Close">✕</button>
						</div>
						<p>These two multipliers control how the K/D score of each pixel turns into color.</p>
						<dl>
							<dt>Exposure</dt>
							<dd>How far a K/D difference pushes a pixel to red or to blue. A higher value gives more solid colors.</dd>
							<dt>Brightness</dt>
							<dd>How much the number of data points counts. A higher value makes the pixels less transparent.</dd>
						</dl>
						<div class="infoExamples">
							<div>
								<b>8 + 64</b>
								<span>Finds positions with an <i>especially high</i> K/D, and dims the noise.</span>
							</div>
							<div>
								<b>64 + 255</b>
								<span>Fills the screen with the average, no matter how much data there is or how sure it is.</span>
							</div>
						</div>
					</div>
					<div class="ctlRow">
						<label for="tankmapBrightnessSlider">Map brightness</label>
						<input id="tankmapBrightnessSlider" type="range" min="0" max="100" value="35"/>
					</div>
				</section>
				<section class="ctlGroup">
					<h3>Filters</h3>
					<div class="ctlRow">
						<span class="ctlLabel">Team</span>
						<div class="segmented" role="radiogroup" aria-label="Team">
							<label><input type="radio" name="team" value="" checked/><span>Any</span></label>
							<label><input type="radio" name="team" value="1"/><span>1</span></label>
							<label><input type="radio" name="team" value="2"/><span>2</span></label>
						</div>
					</div>
					<div class="ctlRow">
						<label for="killTimeMin">Kill time</label>
						<input id="killTimeMin" name="killTimeMin" type="number" value="" min="0" max="1800" placeholder="min"/>
						<span>to</span>
						<input name="killTimeMax" type="number" value="" min="0" max="1800" placeholder="max" aria-label="Kill time max"/>
						<span>s</span>
					</div>
					<small class="hint">First <i>spawns</i> actually occur at around 40 second mark, offset filters accordingly.</small>
					@vehicleFilter("Killer", "killer", battleRatingMax)
					@vehicleFilter("Victim", "victim", battleRatingMax)
				</section>
				<small class="hint">
					Data filters miss the cache, so a load with filters takes longer.
					<br/>
					Drag to pan, scroll to zoom, double click to reset the view.
				</small>
				<button type="submit" id="settingsSubmitBtn"><span id="settingsSubmitBtnText">Load</span></button>
			</form>
		</div>
		<div id="areaPanel" class="areastats" popover>
			<div class="areaHead">
				<button type="button" id="areaSelectBtn">Select area</button>
				<button type="button" id="areaClearBtn" disabled>Clear area</button>
			</div>
			<small class="hint">
				Drag a box on the map to get the kills and deaths of every vehicle in it.
				The data filters apply to the box as well.
			</small>
			<div id="areaStatsResults"></div>
		</div>
	</div>
	<script type="module" src={ StaticAssets.URL("main.js") }></script>
}

templ vehicleFilter(title, prefix string, battleRatingMax int) {
	<fieldset class="vehicleFilter">
		<legend>{ title } vehicle</legend>
		@brSelector(prefix+"BattleRatingMin", "BR min", battleRatingMax)
		@brSelector(prefix+"BattleRatingMax", "BR max", battleRatingMax)
		<select name={ prefix + "VehicleClass" } aria-label={ title + " class" }>
			<option value="" selected>Any class</option>
			<option value="exp_heavy_tank">Heavy tank</option>
			<option value="exp_SPAA">SPAA</option>
			<option value="exp_tank">Tank (light, medium)</option>
			<option value="exp_tank_destroyer">Tank destroyer</option>
		</select>
		<select name={ prefix + "VehicleCountry" } aria-label={ title + " country" }>
			<option value="" selected>Any country</option>
			<option value="country_britain">Britain</option>
			<option value="country_china">China</option>
			<option value="country_france">France</option>
			<option value="country_germany">Germany</option>
			<option value="country_israel">Israel</option>
			<option value="country_italy">Italy</option>
			<option value="country_japan">Japan</option>
			<option value="country_sweden">Sweden</option>
			<option value="country_usa">USA</option>
			<option value="country_ussr">USSR</option>
		</select>
	</fieldset>
}

templ brSelector(name, empty string, battleRatingMax int) {
	<select name={ name } aria-label={ empty }>
		<option value="" selected>{ empty }</option>
		for i := range battleRatingMax+1 {
			<option value={ i }>{ BRString(i) }</option>
		}
	</select>
}

type Vehicle struct {
	ID        string
	Rank      int
	IsPremium bool
	IsEvent   bool
}

type AreaVehicleStat struct {
	Vehicle Vehicle
	Kills   int
	Deaths  int
}

templ AreaStats(stats []AreaVehicleStat, widthMeters, heightMeters, total, limit int) {
	<p>
		Area { widthMeters } x { heightMeters } meters.
		if len(stats) == 0 {
			Nothing was killed here.
		} else {
			{{
				var globKills, globDeaths int
				for _, v := range stats {
					globDeaths += v.Deaths
					globKills += v.Kills
				}
			}}
			{ total } data points. Average area K/D: { KillDeathRatio(globKills, globDeaths) }
			if len(stats) == limit {
				<br/>
				<small>Only the { limit } most common vehicles are listed.</small>
			}
		}
	</p>
	if len(stats) > 0 {
		<table class="areaTable">
			<colgroup>
				<col/>
				<col class="num"/>
				<col class="num"/>
				<col class="num"/>
				<col class="num"/>
			</colgroup>
			<thead>
				<tr>
					<th>Vehicle</th>
					<th>Kills</th>
					<th>Deaths</th>
					<th>Σ</th>
					<th>K/D</th>
				</tr>
			</thead>
			<tbody>
				for _, v := range stats {
					<tr>
						<td>
							<div class="vehicleCell">
								@vehicleSlotIcon(v.Vehicle)
								<span class="marquee"><span>
									@vehicleName(v.Vehicle)
								</span></span>
							</div>
						</td>
						<td>{ v.Kills }</td>
						<td>{ v.Deaths }</td>
						<td>{ v.Kills+v.Deaths }</td>
						<td>{ KillDeathRatio(v.Kills, v.Deaths) }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

templ VehicleLabel(v Vehicle) {
	@vehicleSlotIcon(v)
	@vehicleName(v)
}

templ vehicleSlotIcon(v Vehicle) {
	<img class="vehicleIcon" src={ "https://static.encyclopedia.warthunder.com/slots/" + v.ID + ".png" } alt="" loading="lazy" onerror="this.remove()"/>
}

templ vehicleName(v Vehicle) {
	<a href={ "https://wiki.warthunder.com/unit/" + v.ID } target="_blank">
		if v.IsEvent {
			<i>{ v.ID } </i>
		} else {
			{ v.ID }
		}
	</a>
	if v.IsPremium {
		<img class="vehicleIcon premiumIcon" src="https://static.encyclopedia.warthunder.com/gui_skin/item_type_talisman.svg" alt="" loading="lazy" onerror="this.remove()"/>
	}
}

type StatsTable struct {
	Caption      string
	ColumnLabels []string
	Rows         [][]templ.Component
}

templ Stats(stats []StatsTable, ingestStatSessionRate5m, ingestStatKillsRate5m int) {
	<style>
		.stats {
			display: flex;
			justify-content: space-evenly;
		}
		.stat {
			padding: 1em;
		}
	</style>
	<div style="text-align: center;">
		Ingest rate: { ingestStatSessionRate5m } sessions { ingestStatKillsRate5m } kills per 5 minutes
	</div>
	<div class="stats">
		for _, t := range stats {
			<div class="stat">
				<table>
					<caption style="caption-side: top">
						@templ.Raw(t.Caption)
					</caption>
					<thead>
						<tr>
							for _, v := range t.ColumnLabels {
								<th>{ v }</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, r := range t.Rows {
							<tr>
								for _, v := range r {
									<td>
										@v
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

templ StatElementFixedPercentBar(percent float64) {
	<span class="statBarGreen" style={ fmt.Sprintf("width: %dpx", int(math.Round(100*percent))) }></span><span class="statBarGray" style={ fmt.Sprintf("width: %dpx", int(math.Round(100*(1-percent)))) }></span>
}

templ TextNode(content string) {
	{ content }
}

